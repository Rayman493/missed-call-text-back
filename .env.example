# Supabase
# Required for browser/client-side (public)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Required for server-side API routes only (never exposed to browser)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number
TWILIO_MESSAGING_SERVICE_SID=your_twilio_messaging_service_sid

# SMS Simulation (development/testing only)
# Set to 'true' to simulate SMS without real delivery
# WARNING: Only use in development/testing environments
SIMULATE_SMS=false

# Cron Jobs (server-side only, never exposed to browser)
CRON_SECRET=your_random_secret_for_cron_jobs

# Upstash Redis (for rate limiting)
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI Call Assistant (Production)
# Enable AI voice answering for missed calls
AI_CALL_ASSISTANT_ENABLED=true
NEXT_PUBLIC_AI_CALL_ASSISTANT_ENABLED=true
AI_CALL_ASSISTANT_ALLOWED_BUSINESS_IDS=
AI_ASSISTANT_USE_POC=true
AI_VOICE_FLY_WS_URL=wss://replyflow-ai-voice.fly.dev/stream

# OpenAI (for AI Call Assistant)
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1

# Sentry (Production Error Monitoring)
# Required for frontend error tracking (public)
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn
# Required for Sentry server-side configuration
SENTRY_ORG=your_sentry_org
SENTRY_PROJECT=your_sentry_project
# Required for source map uploads during build
SENTRY_AUTH_TOKEN=your_sentry_auth_token

# Apple In-App Purchase (App Store Server API, server-side only except NEXT_PUBLIC_*)
# App Store Connect → Users and Access → Integrations → App Store Connect API
# (In-App Purchase key; never commit the .p8 private key value)
APPLE_STOREKIT_ISSUER_ID=your_apple_issuer_id
APPLE_STOREKIT_KEY_ID=your_apple_key_id
APPLE_STOREKIT_PRIVATE_KEY=your_apple_p8_private_key_pem
# App Store Connect → App Information → Bundle ID
APPLE_BUNDLE_ID=com.replyflowhq.app
# Comma-separated auto-renewable product IDs the server will honor
APPLE_SUBSCRIPTION_PRODUCT_IDS=replyflow_monthly_apple
# Product ID the iOS client requests from StoreKit (public)
NEXT_PUBLIC_APPLE_PRODUCT_ID=replyflow_monthly_apple
# Optional: force the App Store Server API base (defaults auto-select
# Sandbox/Production per transaction environment). QA only.
APPLE_STOREKIT_API_BASE=

# Google Ads conversion tracking (web signup measurement)
# Google Ads → Goals → Conversions → your "Sign up" action → Tag setup.
# Tag ID looks like AW-123456789; the conversion label is the alphanumeric
# string after the tag ID in the event snippet (send_to: AW-.../<label>).
# Both must be set for the Google tag to load and the signup conversion to
# fire. Leave unset to keep tracking fully inert.
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_ID=your_aw_conversion_id
NEXT_PUBLIC_GOOGLE_ADS_SIGNUP_LABEL=your_signup_conversion_label
