# ============================================================================
# QA ENVIRONMENT TEMPLATE — never copy production values into this file.
#
# Deploy as a SEPARATE Vercel project on the `qa` branch (or a dedicated
# project). REPLYFLOW_ENV=qa activates fail-closed isolation checks at
# startup (src/instrumentation.ts -> assertQaIsolation): the app refuses to
# boot if any production Supabase, Stripe, Twilio, or Fly resource is
# configured.
# ============================================================================

# REQUIRED — marks this deployment as QA (independent of NODE_ENV/VERCEL_ENV)
REPLYFLOW_ENV=qa

# --- Web app URL: the QA deployment's own public URL -------------------------
NEXT_PUBLIC_APP_URL=https://qa.replyflowhq.com
NEXT_PUBLIC_SITE_URL=https://qa.replyflowhq.com

# --- Supabase: dedicated QA project (fresh, all migrations applied) ---------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_QA_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=qa_anon_key
SUPABASE_SERVICE_ROLE_KEY=qa_service_role_key

# --- Stripe: TEST mode only. sk_live_/rk_live_ keys fail startup. -----------
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_qa_test_webhook
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_qa_connect_webhook
NEXT_PUBLIC_STRIPE_PRICE_ID=price_test_xxx
NEXT_PUBLIC_STRIPE_CONNECT_ENABLED=true

# --- Twilio: dedicated account or SUBACCOUNT only. ---------------------------
# REPLYFLOW_EXPECTED_TWILIO_ACCOUNT_SID must equal TWILIO_ACCOUNT_SID or the
# app refuses to start. Never the production parent account.
TWILIO_ACCOUNT_SID=AC_qa_subaccount_sid
TWILIO_ACCOUNT_SUBACCOUNT_SID=
TWILIO_AUTH_TOKEN=qa_twilio_auth_token
REPLYFLOW_EXPECTED_TWILIO_ACCOUNT_SID=AC_qa_subaccount_sid
TWILIO_PHONE_NUMBER=+15550001234
TWILIO_MESSAGING_SERVICE_SID=MG_qa_messaging_service

# Deliveries: keep simulated where possible
SIMULATE_SMS=true
USE_SHARED_TWILIO_NUMBER=false

# --- AI voice service: dedicated QA Fly app ----------------------------------
AI_CALL_ASSISTANT_ENABLED=true
NEXT_PUBLIC_AI_CALL_ASSISTANT_ENABLED=true
AI_VOICE_FLY_WS_URL=wss://replyflow-ai-voice-qa.fly.dev/stream
AI_ASSISTANT_USE_POC=true

# --- OpenAI / Resend / Google ------------------------------------------------
OPENAI_API_KEY=sk-proj-qa
OPENAI_BASE_URL=https://api.openai.com/v1
RESEND_API_KEY=re_qa
RESEND_FROM_EMAIL=qa@replyflowhq.com
GOOGLE_CLIENT_ID=qa_google_oauth_client
GOOGLE_CLIENT_SECRET=qa_google_oauth_secret
GOOGLE_REDIRECT_URI=https://qa.replyflowhq.com/api/google/calendar/callback
GOOGLE_OAUTH_STATE_SECRET=qa_state_secret

# --- Push: use a separate Firebase project + APNs development environment ---
FIREBASE_PROJECT_ID=replyflow-qa
FIREBASE_CLIENT_EMAIL=qa_firebase_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nqa\n-----END PRIVATE KEY-----\n"
APNS_KEY_ID=qa_apns_key
APNS_TEAM_ID=qa_apns_team
APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nqa\n-----END PRIVATE KEY-----\n"
APNS_BUNDLE_ID=com.replyflowhq.app
APNS_ENV=development

# --- Infra: separate QA resources --------------------------------------------
UPSTASH_REDIS_REST_URL=https://qa-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=qa_token
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Secrets: UNIQUE values, never the production ones -----------------------
CRON_SECRET=qa_cron_secret
ADMIN_SECRET=qa_admin_secret
PROVISIONING_ADMIN_SECRET=qa_provisioning_secret
INTERNAL_API_SECRET=qa_internal_api_secret
MMS_MEDIA_SECRET=qa_mms_secret
GOOGLE_PLAY_RTDN_SECRET=qa_rtdn_secret
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON={}
GOOGLE_PLAY_PACKAGE_NAME=com.replyflowhq.app
GOOGLE_PLAY_SUBSCRIPTION_PRODUCT_IDS=replyflow_monthly

# Crons stay OFF in QA by default (mutate Twilio/SMS/billing). Opt-in only:
ALLOW_NON_PROD_CRONS=false

# --- Voice service (fly.qa.toml app) -----------------------------------------
# Set on the Fly app replyflow-ai-voice-qa:
#   REPLYFLOW_ENV=qa
#   MAIN_APP_URL=https://qa.replyflowhq.com
#   BASE_URL=https://replyflow-ai-voice-qa.fly.dev
#   SUPABASE_URL=https://YOUR_QA_PROJECT_REF.supabase.co
#   SUPABASE_SERVICE_ROLE_KEY=qa_service_role_key
#   TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN (QA account only)
#   REPLYFLOW_EXPECTED_TWILIO_ACCOUNT_SID
#   OPENAI_API_KEY, INTERNAL_API_SECRET (QA values)
